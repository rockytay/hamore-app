# Copy to .env.local (never committed) and fill in.
# Local Supabase: run `npx supabase start`, then copy "API URL" and the publishable key it prints.
# On a phone with Expo Go, use your computer's LAN IP instead of 127.0.0.1, e.g. http://192.168.1.20:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only for `npm run seed:dev` (runs on your computer, never shipped in the app).
# Local Supabase: the "Secret key" from `npx supabase status`.
SUPABASE_SECRET_KEY=
