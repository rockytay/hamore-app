# Copy to .env.local (never committed) and fill in.
# Hosted Supabase project. The publishable key is meant for the app and safe to share;
# row-level security in the database decides what each user can see.
EXPO_PUBLIC_SUPABASE_URL=https://ovqolxqznfbxynrjvzny.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_oOrrAmVcIOp9tn9iWxKkuw_v1cl4mwL

# Local Supabase instead: run `npx supabase start`, then use the "API URL" and publishable key it prints.
# On a phone with Expo Go, use your computer's LAN IP instead of 127.0.0.1, e.g. http://192.168.1.20:54321
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only for `npm run seed:dev` (runs on your computer, never shipped in the app).
# Local Supabase: the "Secret key" from `npx supabase status`.
SUPABASE_SECRET_KEY=

# Only for `npm run db:clear-users` on the HOSTED project (Dashboard → Project Settings → API Keys → Secret key).
# Never commit the real value.
SUPABASE_HOSTED_SECRET_KEY=
